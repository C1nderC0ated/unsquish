<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development tool: measures the restoration engines against clean reference pictures. Not part of the release. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>unsquish-bench</AssemblyName>
    <RootNamespace>Unsquish.Bench</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <NoWarn>CA1416;NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Dct.cs;..\..\Coefs.cs;..\..\Restore.cs;..\..\Presets.cs;..\..\Jpeg.cs;..\..\Imaging.cs;..\..\Exif.cs;..\..\History.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BitMiracle.LibJpeg.NET" Version="1.5.324" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
</Project>
